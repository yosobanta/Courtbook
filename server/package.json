{
  "name": "courtbook-server",
  "version": "1.0.0",
  "description": "CourtBook - Sports Court Discovery & Booking Backend (MongoDB / NoSQL Course Project)",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "seed": "ts-node src/utils/seedData.ts",
    "test:concurrency": "ts-node tests/concurrency.test.ts",
    "test:atomicity": "ts-node tests/atomicity.test.ts"
  },
  "keywords": [
    "mongodb",
    "nosql",
    "concurrency",
    "acid-transactions",
    "jetpack-compose",
    "booking-system"
  ],
  "author": "CourtBook Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
